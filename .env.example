# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# ---------------------------------------------------------------------------
# Confluence Cloud
# ---------------------------------------------------------------------------
# Base URL of your Confluence Cloud site (no trailing slash).
CONFLUENCE_BASE_URL=https://neurealm-team-juadifpx.atlassian.net/wiki
# Space key this agent watches for spec changes.
CONFLUENCE_SPACE_KEY=SD
# Atlassian account email used to authenticate (Basic Auth: email + API token).
CONFLUENCE_USER_EMAIL=you@example.com
# API token generated at https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=
# Shared secret configured on the Confluence webhook (used to verify inbound
# webhook requests via HMAC-SHA256). Leave blank to disable verification
# (fine for local POC, NOT recommended once the endpoint is public).
CONFLUENCE_WEBHOOK_SECRET=
# Comma-separated Confluence labels. A page must carry at least one of these
# to be processed -- everything else (meeting notes, design docs, other
# project content in the same space) is ignored. Leave blank to process any
# page (no filtering). Easiest to manage via the tag-list editor at
# /ui/config rather than editing this line directly.
CONFLUENCE_ALLOWED_LABELS=
# Confluence Cloud has no self-service webhook registration (that requires
# building a Forge/Connect app), so polling is the real trigger mechanism:
# on a timer, searches for pages with the labels above and runs the
# pipeline for each. /ui/simulate also has a "Poll now" button to fire one
# cycle on demand regardless of this setting.
CONFLUENCE_POLL_ENABLED=false
CONFLUENCE_POLL_INTERVAL_SECONDS=300

# ---------------------------------------------------------------------------
# Repository (target repo the agent implements changes in)
# ---------------------------------------------------------------------------
# One of: github | azure_devops | gitlab | bitbucket -- only github is
# actually implemented today; the rest are reserved for future support.
REPO_PROVIDER=github
# Fine-grained PAT with Contents + Pull requests read/write on the target repo.
GITHUB_TOKEN=
# owner/name of the repo this agent should check out and open PRs against.
TARGET_REPO=your-org/your-repo
# Branch to base new branches / PRs off of.
TARGET_REPO_BASE_BRANCH=main
# Local shell command run inside the checked-out repo to validate the agent's
# change before a PR is opened. Must exit 0 to proceed.
TARGET_REPO_TEST_COMMAND=pytest
# Free-text conventions (naming, layout, patterns to prefer/avoid) applied to
# every repo that doesn't set its own in the TARGET_REPOS_JSON multi-repo
# table (raw JSON, edited via /ui/config's repeating-row editor). The change
# engine is also always told to look for and follow any CONTRIBUTING.md/
# STYLE_GUIDE.md/linter config already in the repo -- this is for guidance
# that isn't written down in the repo itself.
CODING_STANDARDS=
# Confluence page id of a pinned, org-wide engineering-standards page,
# fetched once per run and folded into the same prompt section as
# CODING_STANDARDS above. Leave blank to skip.
STANDARDS_CONFLUENCE_PAGE_ID=

# ---------------------------------------------------------------------------
# Change engine -- the code-writing backend. Pick one; only that engine's
# credential below needs to be set. See docs/change-engines.md.
# ---------------------------------------------------------------------------
# One of: claude_code | cursor | copilot | codex | gemini | antigravity
CHANGE_AGENT_ENGINE=claude_code
# Safety cap on cost/runtime. claude_code enforces this as an actual agentic
# turn limit; the others have no such concept, so it's converted into a
# wall-clock timeout instead (see agent/engines/_subprocess_utils.py).
CHANGE_AGENT_MAX_TURNS=30
# Self-correction loop: if TARGET_REPO_TEST_COMMAND fails, the agent gets
# another attempt with the failure output fed back into its prompt, up to
# this many attempts total. 1 disables retrying (original behavior).
CHANGE_AGENT_MAX_ATTEMPTS=3

# claude_code engine: requires the `claude` CLI on PATH (npm install -g
# @anthropic-ai/claude-code) plus this key.
ANTHROPIC_API_KEY=

# cursor engine: requires the `agent` CLI on PATH
# (curl https://cursor.com/install -fsS | bash) plus this key.
CURSOR_API_KEY=

# copilot engine: requires the `copilot` CLI on PATH
# (npm install -g @github/copilot, Node 22+). Reuses GITHUB_TOKEN above --
# no separate credential needed.

# codex engine: requires the `codex` CLI on PATH
# (npm install -g @openai/codex, Node 22+) plus this key.
OPENAI_API_KEY=

# gemini engine: requires the `gemini` CLI on PATH
# (npm install -g @google/gemini-cli, Node 18+) plus this key.
GEMINI_API_KEY=

# antigravity engine: requires the `agy` CLI on PATH
# (curl -fsSL https://antigravity.google/cli/install.sh | bash). OAuth-only --
# no API key exists for it. Run `agy login` interactively once; headless runs
# then use the cached credentials. Not container-friendly without mounting
# those cached credentials in.

# ---------------------------------------------------------------------------
# LLM Judge -- review gate after tests pass, before a PR opens. An
# independent model reviews the actual code diff against the spec change and
# can still reject it (a green test suite doesn't prove the spec was
# implemented). Independent of CHANGE_AGENT_ENGINE by design. If the
# selected provider's API key isn't set, this step is skipped rather than
# blocking the PR.
# ---------------------------------------------------------------------------
JUDGE_ENABLED=true
# One of: anthropic | openai. Uses ANTHROPIC_API_KEY / OPENAI_API_KEY above.
JUDGE_PROVIDER=anthropic
# Leave blank to use the provider's own default model.
JUDGE_MODEL=

# ---------------------------------------------------------------------------
# Jira -- optional. Tracks each spec change as a Jira story (created once,
# reused/commented on for the same page while still open, never duplicated),
# updated with the PR link or a failure explanation once the run finishes.
# Uses JUDGE_PROVIDER/JUDGE_MODEL above for the LLM call that writes the
# story's description -- no separate provider setting needed.
# ---------------------------------------------------------------------------
JIRA_ENABLED=false
# Site root, e.g. https://your-team.atlassian.net -- no /wiki suffix (that's
# Confluence-specific; Jira Cloud's REST API lives at the site root).
JIRA_BASE_URL=
# Atlassian account email (Basic Auth: email + API token, same pattern as
# Confluence). Generate the token at
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
# Which project new stories are created in, e.g. SD.
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Story
# Adds an "AI-suggested complexity" comment (not a real Story Points value --
# that field is a per-instance custom field with no stable name, and an
# LLM's number has no basis in your team's velocity calibration). A human
# still sizes the story; this is just a starting signal.
JIRA_SUGGEST_STORY_POINTS=false
# Opt-in human-approval gate, off by default: today's behavior (story is
# created and implementation starts in the same run) is unchanged unless you
# turn this on. When true, run_pipeline stops right after the story is
# created/updated and waits for it to reach JIRA_APPROVED_STATUS_NAME below
# before cloning/implementing anything -- see pipeline/approval_poller.py.
# Also the gate the "Plan a Sprint" tab's per-page Approve action relies on.
JIRA_APPROVAL_REQUIRED=false
# The exact Jira workflow status (not category) that means a human approved
# a story for implementation -- matched case-insensitively. Required for
# JIRA_APPROVAL_REQUIRED (and Plan a Sprint's Approve action) to do
# anything; must be a real status in this project's workflow.
JIRA_APPROVED_STATUS_NAME=

# ---------------------------------------------------------------------------
# Team notification email -- pick one provider; only its key below is used.
# ---------------------------------------------------------------------------
# One of: sendgrid | postmark
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
# Postmark calls this a "Server Token" -- from your Postmark server's API
# Tokens tab, not your account-level API key.
POSTMARK_API_KEY=
EMAIL_FROM_ADDRESS=confluence-pr-agent@example.com
# Comma-separated list of recipient addresses.
EMAIL_TO_ADDRESSES=team@example.com

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
# Where the base data directory lives -- each user's own config/page-store/
# run-history/repo-clones live under DATA_DIR/users/<username>/, created
# automatically the first time that username is seen (see config.py).
DATA_DIR=./data
# Host/port the webhook receiver binds to.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
LOG_LEVEL=INFO
# This app is multi-tenant: every setting/credential/run-history is scoped
# to whichever username Caddy's Basic Auth forwards (see Caddyfile.example
# and INTERNAL_SHARED_SECRET below). DEFAULT_USER is who two things fall
# back to when there's no such identity to resolve: (1) /webhook/confluence
# -- a real webhook delivery has no logged-in user attached to it at all --
# and (2) local `uvicorn --reload` dev with no Caddy in front. Blank means
# /webhook/confluence still works (falls back to a literal "default"
# bucket) but local dev without Caddy 401s on every /ui/* route.
DEFAULT_USER=

# ---------------------------------------------------------------------------
# Optional: the `caddy` service in podman-compose.yml (see Caddyfile.example)
# -- only needed once you're exposing this beyond localhost. docker/podman
# compose reads this .env file directly for its own ${DOMAIN}/
# ${INTERNAL_SHARED_SECRET} substitution, separately from the app's own
# env_file loading above.
# ---------------------------------------------------------------------------
# Your real domain (e.g. confluence-pr-agent.neurealm.com) for automatic
# Let's Encrypt HTTPS, or http://localhost:8080 for local testing without a
# domain -- see Caddyfile.example for details.
DOMAIN=
# Required before using the public (caddy) profile -- generate with
# `openssl rand -hex 32`. Proves a request claiming to be a given
# Basic-Auth-authenticated user actually came through Caddy, not straight
# at the app's internal port -- see Caddyfile.example for the full
# reasoning. Must be the exact same value the app service sees too (it
# already gets this file via env_file above); podman-compose.yml refuses
# to start the caddy service at all if this is blank.
INTERNAL_SHARED_SECRET=
